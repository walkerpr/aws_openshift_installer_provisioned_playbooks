{
  "ignition": { "version": "3.1.0" },
  "storage": {
    "files": [
      {
        "path": "/etc/resolv.conf",
        "mode": 420,
        "overwrite": true,
        "contents": { "source": "data:text/plain;base64,{{ resolv_conf_file | b64encode }}" }
      },
      {
        "path": "/usr/local/bin/lock-resolv-conf.sh",
        "mode": 493,
        "overwrite": true,
        "contents": { "source": "data:text/plain;base64,{{ lock_resolv_conf_sh_file | b64encode }}" }
      },
      {
        "path": "/usr/local/bin/set-hostname.sh",
        "mode": 493,
        "overwrite": true,
        "contents": { "source": "data:text/plain;base64,{{ set_hostname_sh_file | b64encode }}" }
      }
    ]
  },
  "systemd": {
    "units": [
      {
        "contents": "[Service]\nType=oneshot\nExecStart=/usr/local/bin/lock-resolv-conf.sh\n\n[Install]\nWantedBy=multi-user.target\n",
        "enabled": true,
        "name": "lock-resolv-conf.service"
      },
      {
        "contents": "[Unit]\nAfter=network-online.target\n\n[Service]\nType=oneshot\nExecStart=/usr/local/bin/set-hostname.sh\n\n[Install]\nWantedBy=multi-user.target\n",
        "enabled": true,
        "name": "set-hostname.service"
      }
    ]
  }
}

