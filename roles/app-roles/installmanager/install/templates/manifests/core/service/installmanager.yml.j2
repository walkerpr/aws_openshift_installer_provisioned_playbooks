---

apiVersion: v1
kind: Service
metadata:
  annotations:
    version: {{ sample_version }}
  labels:
    app: installmanager
  name: installmanager
  namespace: application-sample
spec:
  ports:
    - name: 8009-tcp
      port: 8009
      protocol: TCP
      targetPort: 8009
  selector:
    app: installmanager
  sessionAffinity: None
  type: ClusterIP

