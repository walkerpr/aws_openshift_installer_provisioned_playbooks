---

apiVersion: route.openshift.io/v1
kind: Route
metadata:
  annotations:
    version: {{ sample_version }}
  labels:
    app: httpd
  name: httpd
  namespace: application-sample
spec:
    host: {{ proxy_host }}
    port:
      targetPort: https
    tls:
      termination: passthrough
    to:
      kind: Service
      name: httpd

