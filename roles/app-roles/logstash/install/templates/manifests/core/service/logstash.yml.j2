---

apiVersion: v1
kind: Service
metadata:
  annotations:
    version: {{ sample_version }}
  labels:
    app: logstash
  name: logstash
  namespace: application-sample
spec:
  ports:
    - name: 8080-tcp
      port: 8080
      protocol: TCP
      targetPort: 8080
    - name: 5044-tcp
      port: 5044
      protocol: TCP
      targetPort: 5044
  selector:
    app: logstash
  sessionAffinity: None
  type: ClusterIP

