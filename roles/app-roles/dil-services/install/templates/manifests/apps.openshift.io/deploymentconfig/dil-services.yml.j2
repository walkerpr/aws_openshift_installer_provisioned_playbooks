---

apiVersion: apps.openshift.io/v1
kind: DeploymentConfig
metadata:
  annotations:
    version: {{ sample_version }}
  labels:
    app: dil-services
  name: dil-services
  namespace: application-sample
spec:
  replicas: 1
  selector:
    app: dil-services
    deploymentconfig: dil-services
  strategy:
    type: Rolling
    rollingParams:
      updatePeriodSeconds: 1
      intervalSeconds: 1
      timeoutSeconds: 600
  template:
    metadata:
      labels:
        app: dil-services
        deploymentconfig: dil-services
    spec:
      containers:
        - env:
            - name: new_truststore_password
              valueFrom:
                secretKeyRef:
                  key: password
                  name: newtruststorepassword
            - name: new_keystore_password
              valueFrom:
                secretKeyRef:
                  key: password
                  name: newkeystorepassword
            - name: key_password
              valueFrom:
                secretKeyRef:
                  key: password
                  name: keypassword
            - name: keystore_password
              valueFrom:
                secretKeyRef:
                  key: password
                  name: keystorepassword
          envFrom:
            - configMapRef:
                name: sampleproperties
          image: >-
            {{ pull_repository }}/dil-services:{{ sample_version }}
          imagePullPolicy: Always
          livenessProbe:
            tcpSocket:
              port: 5555
            initialDelaySeconds: 900
            periodSeconds: 20
            timeoutSeconds: 1
          name: dil-services
          ports:
            - containerPort: 5555
              protocol: TCP
          readinessProbe:
            failureThreshold: 43
            tcpSocket:
              port: 5555
            initialDelaySeconds: 30
            periodSeconds: 20
            timeoutSeconds: 5
          resources: {}
          terminationMessagePath: /dev/termination-log
          terminationMessagePolicy: File
          volumeMounts:
            - mountPath: /opt/applicationsample/certs/server
              name: volume-dil-servicescerts
            - mountPath: /var/lib/dil-services
              name: volume-data
              subPath: dil-services
            - mountPath: /opt/applicationsample/dil/ca
              name: volume-dil-services
      dnsPolicy: ClusterFirst
      restartPolicy: Always
      schedulerName: default-scheduler
      securityContext:
        supplementalGroups: [ 65534 ]
      serviceAccount: sample-sa
      serviceAccountName: sample-sa
      terminationGracePeriodSeconds: 30
      volumes:
        - name: volume-data
          persistentVolumeClaim:
            claimName: data
        - configMap:
            defaultMode: 420
            name: dil-services
          name: volume-dil-services
        - configMap:
            defaultMode: 420
            items:
              - key: cabundle.crt.tmp
                path: cabundle.crt.tmp
              - key: idp.crt
                path: {{ idp_alias }}.crt
              - key: server_private_key
                path: {{ server_alias }}.key
              - key: server_certificate
                path: {{ server_alias }}.crt
            name: certificates
          name: volume-dil-servicescerts
